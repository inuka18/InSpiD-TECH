# =============================================================
# InSPiD-TECH - template. Copy to .env and fill in. Safe to commit.
# Replace every value that starts with REPLACE_ and the two
# <db_...> placeholders in MONGODB_URI. Nothing else needs editing.
# =============================================================

# ---- Backend ----
PORT=5000
NODE_ENV=development
# Browser origin allowed to call the API (Vite dev server).
CORS_ORIGIN=http://localhost:5173

# ---- MongoDB (Atlas) ----
# Replace only <db_username> and <db_password> (keep the rest exactly as is).
# The URI has no database name, so the backend passes MONGODB_DB_NAME to Mongoose.
# Local Mongo instead of Atlas: set MONGODB_URI=mongodb://mongo:27017/ (Docker) or mongodb://localhost:27017/ and run: docker compose --profile localdb up
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/
MONGODB_DB_NAME=inspid

# ---- JWT ----
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=1d

# ---- Neo4j ----
# Docker-network URL. Running the backend outside Docker? Use bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_NEO4J_PASSWORD

# ---- AI service ----
# Docker-network URL. Running the backend outside Docker? Use http://localhost:8000
AI_SERVICE_URL=http://ai-service:8000

# ---- Blockchain (local Hardhat node from docker-compose) ----
# Docker-network URL. Running outside Docker? Use http://localhost:8545
BLOCKCHAIN_RPC_URL=http://hardhat:8545

# ---- Seed users (npm run seed) ----
SEED_PM_PASSWORD=REPLACE_SEED_PM_PASSWORD
SEED_MEMBER_PASSWORD=REPLACE_SEED_MEMBER_PASSWORD
